<svg id="schematic-map" class="schematic-map" viewBox="<%= scenario.camera.join(' ') %>" xmlns="http://www.w3.org/2000/svg" role="group" aria-labelledby="schematic-title schematic-description">
  <title id="schematic-title">宮崎の位置関係を示す模式図</title>
  <desc id="schematic-description">全<%= places.size %>地点を同じ位置に配置しています。北が上。宮崎神宮駅は宮崎駅の北、会場は鉄道の西、宮崎空港は大淀川の南東です。縮尺不同。破線は移動のつながりで、道路に沿った案内ではありません。</desc>
  <rect width="1000" height="900" fill="#f8f5ed" />
  <g class="schematic-context" aria-hidden="true">
    <rect x="165" y="175" width="275" height="215" rx="28" fill="#eee9d9" />
    <text x="160" y="140" class="district-label">文化公園・会場</text>
    <ellipse cx="340" cy="555" rx="96" ry="55" fill="#f2e5d2" />
    <path d="M0 656 C260 630 430 690 630 666 S850 628 1000 656 L1000 706 C800 680 765 706 630 710 S280 675 0 700Z" fill="#cbe5e7" />
    <text x="180" y="687" class="river-label">大淀川</text>
    <path d="M470 50 V770 Q470 795 495 795 H930 M170 490 H865 M220 230 H470" class="schematic-road" />
    <path d="M730 50 V340 L750 390 V720 Q750 795 790 795 H845" class="schematic-rail" />
    <path d="M730 50 V340 L750 390 V720 Q750 795 790 795 H845" class="schematic-sleepers" />
    <text x="660" y="85" class="context-label">JR</text>
    <text x="490" y="620" class="context-label">街の南へ</text>
    <path d="M449 728 l12 -9 l18 18 l12 -9 M732 728 l12 -9 l18 18 l12 -9" class="scale-break" />
  </g>
  <g class="schematic-routes" aria-hidden="true">
    <% scenarios.each do |route_scenario| %>
      <% route_scenario.schematic_routes.each do |path| %>
        <path d="<%= path %>" data-route-scenario="<%= route_scenario.id %>" class="schematic-route <%= 'is-active' if route_scenario.id == scenario.id %>" />
      <% end %>
    <% end %>
  </g>
  <g class="schematic-places">
    <% places.each do |place| %>
      <% point = SchematicLayout.point_for(place) %>
      <% number = scenario.number_of(place) %>
      <g data-map-node="<%= place.id %>" role="button" tabindex="0" aria-label="<%= place.name %>" class="schematic-place <%= 'is-in-scenario' if number %> <%= 'schematic-venue' if place.id == 'venue' %>">
        <title><%= place.name %></title>
        <rect class="point-hit" x="<%= point.x - 45 %>" y="<%= point.y - 45 %>" width="90" height="90" fill="transparent" />
        <circle class="point-ring" cx="<%= point.x %>" cy="<%= point.y %>" r="22" />
        <text data-map-number="true" class="point-number" x="<%= point.x %>" y="<%= point.y + 1 %>" text-anchor="middle" dominant-baseline="central"><%= number %></text>
        <text class="schematic-label" x="<%= point.lx %>" y="<%= point.ly %>" text-anchor="<%= point.anchor %>"><%= point.label %></text>
      </g>
    <% end %>
  </g>
</svg>
