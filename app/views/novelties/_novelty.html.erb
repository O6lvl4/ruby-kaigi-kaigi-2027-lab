<li class="novelty-item" data-novelty-id="<%= novelty.id %>">
  <p class="novelty-category"><%= novelty.category %></p>
  <h4><%= novelty.name %></h4>
  <p class="novelty-provider"><%= novelty.provider %></p>
  <dl>
    <div><dt>対象・入手方法</dt><dd><%= novelty.distribution %></dd></div>
    <div><dt>確認できたこと</dt><dd><%= novelty.note %></dd></div>
  </dl>
  <p class="source"><%= external_link_to novelty.source_label, novelty.source_url %></p>
</li>
