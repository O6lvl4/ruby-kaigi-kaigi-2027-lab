<section id="novelties" class="section reference-section" aria-labelledby="novelties-title">
  <%= section_label '07', 'ノベルティ・記念品', id: 'novelties-title' %>
  <p class="section-intro"><%= Novelty.coverage_note %></p>
  <p class="source">出典確認日 <time datetime="<%= Novelty.checked_at %>"><%= Novelty.checked_at %></time> · <%= novelties.length %>件の実例</p>
  <nav class="archive-sections" aria-label="ノベルティを年から探す">
    <% novelties.map(&:year).uniq.each do |year| %>
      <a href="#novelties-<%= year %>"><%= year %></a>
    <% end %>
  </nav>
  <% novelties.group_by(&:year).each do |year, items| %>
    <article id="novelties-<%= year %>" class="archive-card novelty-year" data-novelty-year="<%= year %>" aria-labelledby="novelty-year-<%= year %>">
      <div class="archive-year">
        <h3 id="novelty-year-<%= year %>"><a href="<%= items.first.event_url %>"><%= year %> ↗</a></h3>
        <span><%= items.first.city %></span>
      </div>
      <ul class="novelty-list">
        <%= render items %>
      </ul>
    </article>
  <% end %>
  <h3>販売・デジタル資料</h3>
  <p class="section-intro">公式の「Novelties」「Goodies」には、販売サイトやスライド素材の案内もあります。無料の参加者配布を示すものとしては扱いません。現在の販売・在庫は未確認です。</p>
  <ul class="archive-resources">
    <% Novelty.resources.each do |resource| %>
      <li>
        <%= external_link_to "#{resource.fetch('year')} · #{resource.fetch('label')}", resource.fetch('url') %>
        <% if resource['note'] %><p><%= resource['note'] %></p><% end %>
      </li>
    <% end %>
  </ul>
</section>
