<section id="novelties" class="archive-section" aria-labelledby="novelties-title">
  <div class="archive-section-heading">
    <div><p class="archive-eyebrow">THINGS TO REMEMBER</p><h2 id="novelties-title">ノベルティ・記念品</h2></div>
    <p>土地らしさ、遊び心、日常使い。<br>出典でたどる<%= novelties.length %>件の実例。</p>
  </div>
  <nav class="archive-year-nav" aria-label="ノベルティを年から探す">
    <% novelties.map(&:year).uniq.each do |year| %>
      <a href="#novelties-<%= year %>"><%= year %></a>
    <% end %>
  </nav>
  <details class="archive-coverage">
    <summary>掲載範囲と配布区分について <span>出典確認日 <time datetime="<%= Novelty.checked_at %>"><%= Novelty.checked_at %></time></span></summary>
    <p><%= Novelty.coverage_note %></p>
  </details>
  <% novelties.group_by(&:year).each do |year, items| %>
    <section id="novelties-<%= year %>" class="novelty-year" data-novelty-year="<%= year %>" aria-labelledby="novelty-year-<%= year %>">
      <div class="novelty-year-heading">
        <h3 id="novelty-year-<%= year %>"><%= year %><span><%= items.first.city %></span></h3>
        <p><%= items.length %>件 <a href="<%= items.first.event_url %>">公式サイト ↗</a></p>
      </div>
      <ul class="novelty-list"><%= render items %></ul>
    </section>
  <% end %>
  <details class="archive-shop-notes">
    <summary>販売・デジタル資料 <span><%= Novelty.resources.length %>件のリンク</span></summary>
    <p>公式の「Novelties」「Goodies」には、販売サイトやスライド素材の案内もあります。無料の参加者配布を示すものとしては扱いません。現在の販売・在庫は未確認です。</p>
    <ul class="archive-resources">
      <% Novelty.resources.each do |resource| %>
        <li>
          <%= external_link_to "#{resource.fetch('year')} · #{resource.fetch('label')}", resource.fetch('url') %>
          <% if resource['note'] %><p><%= resource['note'] %></p><% end %>
        </li>
      <% end %>
    </ul>
  </details>
</section>
