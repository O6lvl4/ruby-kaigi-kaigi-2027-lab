<figure class="archive-photo <%= "archive-photo-#{variant}" %>" data-archive-photo="<%= photo.id %>" data-image-kind="<%= photo.kind %>">
  <button type="button" class="archive-photo-open" data-photo-open aria-haspopup="dialog" aria-controls="archive-photo-dialog" aria-label="<%= photo.title %>の画像を拡大">
    <img src="<%= static_file_path(photo.src) %>" alt="<%= photo.alt %>" width="<%= photo.width %>" height="<%= photo.height %>" loading="<%= variant == 'lead' ? 'eager' : 'lazy' %>" decoding="async">
    <span class="archive-photo-kind"><%= photo.kind_label %></span>
    <span class="archive-photo-zoom" aria-hidden="true"><svg viewBox="0 0 20 20" width="14" height="14"><path d="M12 3h5v5M17 3l-6 6M8 17H3v-5M3 17l6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>拡大</span>
  </button>
  <figcaption>
    <p class="archive-photo-title"><% if photo.year %><span><%= photo.year %></span><% end %><strong><%= photo.title %></strong></p>
    <p class="archive-photo-credit"><%= photo.credit %> · <%= photo.license_url ? link_to(photo.license_label, photo.license_url) : photo.license_label %> · <%= external_link_to '出典', photo.source_url, 'aria-label': photo.source_label %></p>
    <% if photo.note %><p class="archive-photo-note"><%= photo.note %></p><% end %>
  </figcaption>
</figure>
