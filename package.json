{
  "name": "rubykaigi-wasm-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node tests/e2e.mjs",
    "setup:runtime": "node scripts/fetch-runtime.mjs",
    "test": "sh scripts/test-node.sh",
    "lint": "npm run lint:js && npm run lint:architecture && npm run lint:ruby",
    "lint:js": "eslint . && prettier --check .",
    "lint:architecture": "depcruise app/javascript --config .dependency-cruiser.cjs",
    "lint:ruby": "bundle exec rubocop && bundle exec erb_lint --lint-all",
    "quality:ruby": "bundle exec rubycritic app config lib db --no-browser --format console",
    "format": "prettier --write . && bundle exec rubocop -a"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@duckdb/duckdb-wasm": "1.29.1-dev132.0",
    "@electric-sql/pglite": "0.2.17",
    "@ruby/wasm-wasi": "2.10.1",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "dependency-cruiser": "18.3.1",
    "eslint": "9.39.5",
    "globals": "15.11.0",
    "playwright": "1.64.0",
    "prettier": "3.3.3",
    "vite": "6.4.4"
  },
  "engines": {
    "node": ">=24.19"
  }
}
