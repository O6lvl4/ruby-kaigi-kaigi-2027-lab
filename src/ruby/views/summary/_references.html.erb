<% dining = @references.fetch('restaurantSection'); archive = @references.fetch('archiveSection') %>
<section id="dining" class="section reference-section" aria-labelledby="dining-title">
  <div class="section-label"><span>05</span><h2 id="dining-title"><%= dining.fetch('title') %></h2></div>
  <p class="section-intro"><%= dining.fetch('intro') %></p>
  <p class="note"><strong>席数と、集まれる人数は別です。</strong><br><%= dining.fetch('capacityNote') %> 価格・コース料金も未確認です。</p>
  <div class="dining-toolbar"><div class="dining-view-switch" aria-label="飲食店の表示方法"><button type="button" data-dining-view="list" aria-pressed="true">一覧</button><button type="button" data-dining-view="map" aria-pressed="false">地図</button></div><div class="dining-filter"><div class="dining-filter-group"><label for="dining-capacity">集まる人数の目安</label><select id="dining-capacity" aria-describedby="capacity-help"><option value="0">すべての候補</option><option value="10">10人以上</option><option value="20">20人以上</option><option value="30">30人以上</option><option value="50">50人以上</option><option value="60">60人以上</option><option value="100">100人以上</option></select></div><div class="dining-filter-group"><label for="dining-area">エリア（町名）</label><select id="dining-area"><option value="all">全エリア</option><% dining.fetch('restaurants').map { |restaurant| GuideLinks.area(restaurant) }.uniq.sort.each do |area| %><option value="<%= area %>"><%= area %></option><% end %></select></div><p id="capacity-help">宴会・着席予約の掲載上限で絞ります。総席数からは推定しません。ホテルは表示中の部屋だけで判定します。</p></div></div>
  <p id="dining-results" class="source" role="status" aria-live="polite"><%= dining.fetch('restaurants').length %>件を掲載（うち人数要確認 <%= dining.fetch('restaurants').count { |restaurant| restaurant['groupCapacity'].nil? } %>件）</p>
  <p id="dining-empty" class="note" hidden>掲載人数の条件に合う候補はありません。人数要確認の候補は下に残しています。</p>
  <section id="dining-map-panel" class="dining-map-panel" aria-label="飲食店の地図と選択した候補" hidden><p id="dining-map-count" class="source"></p><label class="dining-map-choice-label" for="dining-map-choice">候補から選ぶ（重なったピンも選べます）</label><select id="dining-map-choice"><option value="">地点を選択</option><% dining.fetch('restaurants').each_with_index do |restaurant, index| %><% if restaurant['coordinates'] %><option value="<%= restaurant.fetch('id') %>"><%= format('%02d', index + 1) %> · <%= restaurant.fetch('name') %></option><% end %><% end %></select><div class="dining-map-layout"><div class="dining-map-column"><div id="dining-map-canvas" class="dining-map-canvas" role="region" aria-label="飲食店の出典確認済み地点"></div><button type="button" id="dining-map-fit">全地点を見る</button><p class="source">赤は掲載人数の条件内、黄は人数要確認、淡色は条件外。番号は一覧と共通です。ピンは施設・建物の代表点で、入口や乗降場所ではありません。</p><p id="dining-map-status" class="source" role="status" aria-live="polite"></p><p class="source"><a href="https://maps.gsi.go.jp/development/ichiran.html">地理院タイル（淡色地図）</a>に独自の地点を重ねています。</p></div><aside id="dining-map-detail" aria-label="選択した飲食店" aria-live="polite"></aside></div></section>
  <div class="dining-grid"><% dining.fetch('restaurants').each_with_index do |restaurant, index| %>
    <article class="dining-card" data-restaurant-id="<%= restaurant.fetch('id') %>" data-group-capacity="<%= restaurant['groupCapacity'] %>" data-dining-area="<%= GuideLinks.area(restaurant) %>">
      <div class="dining-card-header"><div class="dining-thumbnail"><% if restaurant['thumbnail'] %><img src="<%= restaurant.fetch('thumbnail').fetch('path') %>" alt="<%= restaurant.fetch('thumbnail').fetch('alt') %>" width="96" height="80" loading="lazy" decoding="async"><% else %><span class="thumbnail-symbol" aria-hidden="true">◇</span><span>写真未掲載</span><% end %></div><div class="dining-card-heading"><p class="kicker"><span class="dining-number"><%= format('%02d', index + 1) %></span> <%= restaurant['venueType'] == 'hotel_banquet' ? 'ホテル宴会場' : '飲食店' %> · <%= restaurant['groupCapacity'] ? '掲載人数あり' : '人数要確認' %></p><h3><%= restaurant.fetch('name') %></h3><p class="restaurant-address"><%= restaurant.fetch('address') %></p></div></div>
      <% if restaurant['thumbnail'] %><p class="photo-credit"><a href="<%= restaurant.fetch('thumbnail').fetch('sourceUrl') %>"><%= restaurant.fetch('thumbnail').fetch('credit') %></a> · <a href="<%= restaurant.fetch('thumbnail').fetch('licenseUrl') %>"><%= restaurant.fetch('thumbnail').fetch('license') %></a></p><% end %>
      <% if restaurant['coordinates'] %><button type="button" class="dining-focus" data-dining-focus="<%= restaurant.fetch('id') %>" aria-pressed="false">地図で見る ↗</button><% else %><p class="source">地図上の位置は未確認です</p><% end %>
      <dl class="capacity-facts"><div><dt><%= restaurant['venueType'] == 'hotel_banquet' ? '施設全体の総席数' : '店全体の総席数' %></dt><dd><% if restaurant['totalSeats'] %><strong><%= restaurant.fetch('totalSeats') %></strong> 席<% else %><span>未確認</span><% end %></dd></div><div><dt><%= restaurant.fetch('groupCapacityLabel') %></dt><dd><% if restaurant['groupCapacity'] %><strong><%= restaurant.fetch('groupCapacity') %></strong> 人<% else %><span>人数要確認</span><% end %></dd></div></dl>
      <%= render partial: 'summary/destination_links', locals: { destination: restaurant } %>
      <p class="restaurant-note"><%= restaurant.fetch('note') %></p>
      <details><summary>営業時間・個室・貸切・利用条件</summary><dl class="restaurant-details">
        <% if restaurant['cuisine'] %><dt>料理・利用の目安</dt><dd><%= restaurant.fetch('cuisine') %></dd><% end %>
        <dt>営業時間</dt><dd><%= restaurant['openingHours'] || '未確認。利用日・人数に合わせてお問い合わせください。' %></dd>
        <% if restaurant['coordinatePrecision'] %><dt>地図の位置</dt><dd><%= restaurant.fetch('coordinatePrecision') %> <a href="<%= restaurant.fetch('coordinateSourceUrl') %>">位置の出典 ↗</a></dd><% end %>
        <dt>定休日</dt><dd><%= restaurant['closedDays'] || '未確認' %></dd>
        <dt>立食の掲載人数</dt><dd><% if restaurant['standingCapacity'] %><%= restaurant.fetch('standingCapacity') %>人（<%= restaurant['standingCapacityLabel'] || (restaurant['venueType'] == 'hotel_banquet' ? '表示中の部屋。会場・利用条件は要確認' : '掲載目安。利用条件は要確認') %>）<% else %>未確認<% end %></dd><dt>個室</dt><dd><%= restaurant.fetch('privateRoom') %></dd><dt>貸切</dt><dd><%= restaurant.fetch('privateBooking') %></dd><dt>アクセス上の配慮</dt><dd><%= restaurant.fetch('accessibility') %></dd><dt>2027年の空席・料金</dt><dd>未確認。予約前に店舗へ確認してください。</dd></dl></details>
      <p class="source"><a href="<%= restaurant.fetch('sourceUrl') %>"><%= restaurant.fetch('sourceLabel') %> ↗</a><br>確認日 <time datetime="<%= @references.fetch('checkedAt') %>"><%= @references.fetch('checkedAt') %></time><% if restaurant['sourceUpdatedAt'] %> · 掲載更新 <%= restaurant.fetch('sourceUpdatedAt') %><% end %>
        <% restaurant.fetch('fieldSources', {}).values.flatten.map { |value| restaurant[value] || value }.select { |value| value.is_a?(String) && value.start_with?('https://') && value != restaurant.fetch('sourceUrl') }.uniq.each_with_index do |url, index| %><br><a href="<%= url %>">補足の出典 <%= index + 1 %> ↗</a><% end %></p>
    </article>
  <% end %></div>
  <p class="source"><%= dining.fetch('publicationDisclaimer') %> 掲載情報は変更されることがあります。店舗との条件確認・予約は別途必要です。</p>
</section>
<section id="archive" class="section reference-section" aria-labelledby="archive-title">
  <div class="section-label"><span>06</span><h2 id="archive-title"><%= archive.fetch('title') %></h2></div><p class="section-intro"><%= archive.fetch('intro') %></p>
  <div class="archive-list"><% archive.fetch('years').each do |event| %>
    <article class="archive-card" data-archive-year="<%= event.fetch('year') %>"><div class="archive-year"><a href="<%= event.fetch('url') %>"><%= event.fetch('year') %> ↗</a><span><%= event.fetch('city') %></span></div><div><h3><%= event.fetch('venue') %></h3><p class="archive-dates"><%= event.fetch('dates') %></p><p class="archive-point"><%= event.fetch('point') %></p><nav class="archive-links" aria-label="RubyKaigi <%= event.fetch('year') %> 公式資料"><a href="<%= event.fetch('scheduleUrl') %>">プログラム ↗</a><a href="<%= event.fetch('eventsUrl') %>">交流イベント ↗</a><% if event['operationsUrl'] %><a href="<%= event.fetch('operationsUrl') %>"><%= event.fetch('operationsLabel') %> ↗</a><% end %></nav></div></article>
  <% end %></div>
  <details class="archive-reading"><summary>過去の開催から、どこを読む？</summary><div class="reading-grid"><% archive.fetch('readingPrompts').each do |prompt| %><article><h3><%= prompt.fetch('title') %></h3><p><%= prompt.fetch('fact') %></p><p><strong>読み方の提案：</strong><%= prompt.fetch('inference') %></p><p class="source"><% prompt.fetch('sources').each_with_index do |url, index| %><a href="<%= url %>">公式の実施例 <%= index + 1 %> ↗</a> <% end %></p></article><% end %></div></details>
  <p class="source">各年の公式サイトを参照 · 確認日 <time datetime="<%= @references.fetch('checkedAt') %>"><%= @references.fetch('checkedAt') %></time></p>
</section>
