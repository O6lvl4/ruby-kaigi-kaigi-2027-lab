<div class="map-guide-text"><p class="kicker">THE ROUTE / <%= @guide.fetch(:label) %></p><h2><%= @guide.fetch(:title) %></h2><p><%= @guide.fetch(:description) %></p><details class="journey-note"><summary>交通手段と所要時間 <span aria-hidden="true">＋</span></summary><p><%= @guide.fetch(:guidance) %></p><a href="<%= @guide.fetch(:source) %>">公式の移動案内 ↗</a></details></div>
<div class="location-cards" id="location-cards"><% @guide.fetch(:places).each_with_index do |place, index| %><article class="location-card" data-place-id="<%= place.fetch(:id) %>"><button type="button" class="place-focus" data-map-place="<%= place.fetch(:id) %>" aria-pressed="false"><span class="place-number"><%= index + 1 %></span><span><small><%= place.fetch(:category) %></small><strong><%= place.fetch(:name) %></strong></span><span class="focus-caption" aria-hidden="true">↗</span></button><div class="place-copy"><p><%= place.fetch(:description) %></p><details class="place-details"><summary>出典・位置について</summary><p class="place-precision"><%= place.fetch(:precision_note) %></p><div class="place-links"><a href="<%= place.fetch(:source) %>">案内の出典 ↗</a><a href="<%= place.fetch(:coordinate_source) %>">位置の出典 ↗</a></div></details></div></article><% end %></div>
