<div class="map-guide-text"><p class="kicker">SCENARIO / <%= @guide.fetch(:label) %></p><h3><%= @guide.fetch(:title) %></h3><p><%= @guide.fetch(:description) %></p><details class="journey-note" open><summary>移動の読み方</summary><p><%= @guide.fetch(:guidance) %></p><a href="<%= @guide.fetch(:source) %>">公式の移動案内を見る</a></details></div>
<div class="location-cards" id="location-cards"><% @guide.fetch(:places).each_with_index do |place, index| %><article class="location-card" data-place-id="<%= place.fetch(:id) %>"><button type="button" class="place-focus" data-map-place="<%= place.fetch(:id) %>" aria-pressed="false"><span class="place-number"><%= index + 1 %></span><span><small><%= place.fetch(:category) %></small><strong><%= place.fetch(:name) %></strong></span><span class="focus-caption">地図で見る</span></button><p><%= place.fetch(:description) %></p><p class="place-precision"><%= place.fetch(:precision_note) %></p><div class="place-links"><a href="<%= place.fetch(:source) %>">案内の出典</a><a href="<%= place.fetch(:coordinate_source) %>">位置の出典</a></div></article><% end %></div>
